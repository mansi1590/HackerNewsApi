{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "StoriesCacheDuration": "00:02:00",
    "ItemCacheDuration": "00:10:00",
    "MaxParallelItemRequests": 16,
    "RequestTimeout": "00:00:15",
    "MaxStories": 500
  }
}
